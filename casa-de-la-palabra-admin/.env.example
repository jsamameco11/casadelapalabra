# Wasabi (S3-compatible) — image uploads from the admin forms. Server-only.
# MEDIA_PUBLIC_BASE_URL is the public web app's /m proxy (see its own
# src/lib/wasabi.ts) — needed when the Wasabi account blocks public reads.
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_REGION=us-central-1
WASABI_ENDPOINT=https://s3.us-central-1.wasabisys.com
WASABI_BUCKET=
MEDIA_PUBLIC_BASE_URL=
